<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema aplicado enquanto o processo está iniciando (modo escuro).
         Não define statusBarColor nem navigationBarColor para compatibilidade
         com Android 15+ (edge-to-edge obrigatório / APIs descontinuadas). -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Splash screen nativa; removida automaticamente quando o Flutter
             renderiza o primeiro frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Garante que barras de sistema fiquem transparentes (edge-to-edge) -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- Tema aplicado assim que o processo Flutter é iniciado (modo escuro).
         Determina a cor do Window enquanto a UI Flutter inicializa e ao seu redor. -->
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
